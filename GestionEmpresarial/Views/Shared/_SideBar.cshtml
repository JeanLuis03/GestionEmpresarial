
@inject GestionEmpresarial.Interfaces.ICurrentUserService CurrentUser
@using GestionEmpresarial.Extensions
@using GestionEmpresarial.Helpers.Constants

<div class="sidebar-header">

    CorePlus ERP

</div>

<div class="sidebar-menu">

    <a asp-controller="Home"
       asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">

        <span class="material-symbols-outlined">
            dashboard
        </span>

        Dashboard

    </a>

    @if (User.TienePermiso(PermisosSistema.Consultar))
    {
        <div class="sidebar-group">

            <div class="sidebar-group-title">

                MANTENIMIENTOS

            </div>

            <a asp-controller="Cliente"
               asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cliente" ? "active" : "")">

                <span class="material-symbols-outlined">
                    groups
                </span>

                Clientes

            </a>

            <a asp-controller="Categoria"
               asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categoria" ? "active" : "")">

                <span class="material-symbols-outlined">
                    category
                </span>

                Categorías

            </a>

            <a asp-controller="Producto"
               asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Producto" ? "active" : "")">

                <span class="material-symbols-outlined">
                    inventory_2
                </span>

                Productos

            </a>

            <a asp-controller="Usuario"
               asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuario" ? "active" : "")">

                <span class="material-symbols-outlined">
                    manage_accounts
                </span>

                Usuarios

            </a>

            <div class="sidebar-group-title mt-3">

                REPORTES

            </div>

            <a asp-controller="Reporte"
               asp-action="Productos" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reporte" ? "active" : "")">

                <span class="material-symbols-outlined">
                    assessment
                </span>

                Productos

            </a>

        </div>
    }

</div>

<div class="sidebar-footer">

    <form id="logoutForm"
          asp-controller="Login"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="logout-button">

            <span class="material-symbols-outlined">
                logout
            </span>

            Cerrar Sesión

        </button>

    </form> 

</div>