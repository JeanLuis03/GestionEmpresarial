
@inject GestionEmpresarial.Interfaces.ICurrentUserService CurrentUser
@using GestionEmpresarial.Extensions
@using GestionEmpresarial.Helpers.Constants

<div class="sidebar-header">

    CorePlus ERP

</div>

<div class="sidebar-menu">

    <a asp-controller="Home"
       asp-action="Index">

        <span class="material-symbols-outlined">
            dashboard
        </span>

        Dashboard

    </a>

    @if (User.TienePermiso(PermisosSistema.Consultar))
    {

            <ul class="nav flex-column">

                <li class="nav-item">
                    <a asp-controller="Cliente"
                       asp-action="Index"
                       class="nav-link">

                        <span class="material-symbols-outlined">
                            groups
                        </span>

                        Clientes

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="nav-link">

                        <span class="material-symbols-outlined">
                            inventory_2
                        </span>

                        Productos

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Categorias"
                       asp-action="Index"
                       class="nav-link">

                        <span class="material-symbols-outlined">
                            category
                        </span>

                        Categorías

                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="nav-link">

                        <span class="material-symbols-outlined">
                            manage_accounts
                        </span>

                        Usuarios

                    </a>
                </li>

            </ul>
    }

</div>

<div class="sidebar-footer">

    <form id="logoutForm"
          asp-controller="Login"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="logout-button">

            <span class="material-symbols-outlined">
                logout
            </span>

            Cerrar Sesión

        </button>

    </form> 

</div>