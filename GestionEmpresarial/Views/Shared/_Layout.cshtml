@using GestionEmpresarial.Helpers.Constants
@using GestionEmpresarial.Interfaces
@using System.Globalization
@inject ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
	<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/loading.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/erp-theme.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/GestionEmpresarial.styles.css" asp-append-version="true" />
	<link rel="stylesheet"
		  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
</head>
<body>
	<script src="~/js/theme.js" asp-append-version="true"></script>
	<script src="~/js/loading.js" asp-append-version="true"></script>

	<div id="globalLoadingOverlay" class="loading-overlay" aria-hidden="true">
		<div class="loading-overlay__content">
			<div class="spinner-border text-light" role="status" aria-label="Cargando">
				<span class="visually-hidden">Cargando...</span>
			</div>
			<p class="loading-overlay__title">Procesando información...</p>
			<p class="loading-overlay__subtitle">Espere un momento</p>
		</div>
	</div>

	<div class="app-container">
		<aside class="sidebar">
			@await Html.PartialAsync("_Sidebar")
		</aside>
		<div class="main-content">
			<header class="topbar">
				<div class="d-flex align-items-center gap-2 ms-auto">
					<button type="button"
							class="btn btn-outline-secondary btn-lg theme-toggle-btn d-inline-flex align-items-center gap-2"
							id="themeToggleButton"
							aria-pressed="false">
						<span class="material-symbols-outlined fs-5" id="themeToggleIcon">dark_mode</span>
						<span id="themeToggleText" class="fs-6">Modo Oscuro</span>
					</button>

					<div class="dropdown ms-2">
						<button class="btn profile-button dropdown-toggle"
								type="button"
								data-bs-toggle="dropdown"
								aria-expanded="false">
							<div class="profile-avatar">
								@CurrentUser.NombreUsuario.Substring(0, 1).ToUpper()
							</div>
							@CurrentUser.NombreUsuario
						</button>

						<ul class="dropdown-menu dropdown-menu-end profile-dropdown">
							<li>
								<div class="dropdown-profile-item">
									<small>Rol</small>
									<strong>@CurrentUser.Rol</strong>
								</div>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li>
								<div class="dropdown-profile-item">
									<small>Fecha</small>
									<strong>
										@DateTime.Now.ToString(
											"dd 'de' MMMM 'de' yyyy",
											new CultureInfo("es-DO"))
									</strong>
								</div>
							</li>
						</ul>
					</div>
				</div>
			</header>
			<main class="page-content">
				@RenderBody()
			</main>
		</div>
	</div>

	@await Html.PartialAsync("_SweetAlert")

	<script src="~/js/shared/api.js"></script>
	<script src="~/js/shared/alerts.js"></script>
	<script src="~/js/shared/validators.js"></script>

	@await RenderSectionAsync("Scripts", required: false)

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
