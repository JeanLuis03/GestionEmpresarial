@{
	ViewData["Title"] = "Reportes";
}

<div class="container-fluid">

	<div class="dashboard-header">
		<h2>
			Reportes
		</h2>

		<p>
			Seleccione uno de los reportes disponibles para visualizar información del sistema.
		</p>
	</div>

	<div class="row g-4">

		<div class="col-12 col-md-6 col-lg-4">

			<div class="dashboard-card">

				<span class="material-symbols-outlined">
					inventory_2
				</span>

				<h5>
					Productos por Categoría
				</h5>

				<p class="mb-4">
					Visualiza todos los productos registrados organizados por categoría y permite exportar la información utilizando SQL Server Reporting Services.
				</p>

				<a asp-controller="Reporte"
				   asp-action="Productos"
				   target="_blank"
				   class="btn btn-primary">

					Abrir reporte
				</a>

			</div>

		</div>

		<!-- Futuro reporte Clientes -->
		<!-- Futuro reporte Usuarios -->
		<!-- Futuro reporte Inventario -->

	</div>

</div>
