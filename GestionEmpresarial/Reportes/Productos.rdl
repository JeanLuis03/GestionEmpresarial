    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsProductos">
      <Query>
        <DataSourceName>dbGestionEmpresarial</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT p.Codigo, p.Nombre, p.Marca, p.Modelo, c.Nombre AS Categoria, p.Precio, p.Stock FROM Productos p INNER JOIN Categorias c ON c.Id = p.CategoriaId 
WHERE p.Activo = 1
ORDER BY c.Nombre, p.Nombre</CommandText>
      </Query>
      <Fields>
        <Field Name="Codigo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Codigo</DataField>
        </Field>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="Marca">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Marca</DataField>
        </Field>
        <Field Name="Modelo">
          <rd:TypeName>System.String</rd:TypeName>
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>Modelo</DataField>
        </Field>
        <Field Name="Categoria">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Categoria</DataField>
        </Field>
        <Field Name="Precio">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>Precio</DataField>
        </Field>
        <Field Name="Stock">
          <rd:TypeName>System.Int32</rd:TypeName>
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>Stock</DataField>
        </Field>
      </Fields>
      <WidthSensitivity>True</WidthSensitivity>
    </DataSet>
  </DataSets>
