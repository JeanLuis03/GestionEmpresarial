<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
		xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
	<DataSource Name="dbGestionEmpresarial">
	  <DataSourceReference>dbGestionEmpresarial</DataSourceReference>
	  <rd:DataSourceID>5b4a2f0d-7d8c-4f5d-9b8d-0f8a1d8b7d11</rd:DataSourceID>
	</DataSource>
  </DataSources>
  <DataSets>
	<DataSet Name="dsProductos">
	  <Query>
		<DataSourceName>dbGestionEmpresarial</DataSourceName>
		<CommandText>SELECT p.Codigo, p.Nombre, p.Marca, c.Nombre AS Categoria FROM Productos p INNER JOIN Categorias c ON c.Id = p.CategoriaId ORDER BY c.Nombre, p.Nombre</CommandText>
	  </Query>
	  <Fields>
		<Field Name="Codigo">
		  <DataField>Codigo</DataField>
		  <rd:TypeName>System.String</rd:TypeName>
		</Field>
		<Field Name="Nombre">
		  <DataField>Nombre</DataField>
		  <rd:TypeName>System.String</rd:TypeName>
		</Field>
		<Field Name="Marca">
		  <DataField>Marca</DataField>
		  <rd:TypeName>System.String</rd:TypeName>
		</Field>
		<Field Name="Categoria">
		  <DataField>Categoria</DataField>
		  <rd:TypeName>System.String</rd:TypeName>
		</Field>
	  </Fields>
	</DataSet>
  </DataSets>
